server {
    listen 80;

    # SPA React: estáticos con fallback
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy inverso a Django. La dirección del backend y el DNS llegan por variables
    # de entorno al arrancar: en compose, el nombre del servicio y el DNS de Docker;
    # en Render, la URL de la api de ESTE entorno y un DNS público.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;   # la api de Render es https: sin esto el TLS no sabe a qué host va
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /admin/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /media/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
    }
}